        <mxCell id="backLKB" value="&lt;b&gt;KnowledgeBaseService&lt;/b&gt;&lt;br&gt;BM25Index" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontColor=#1B2A4A;dashed=0;" vertex="1" parent="1"><mxGeometry x="1355" y="230" width="150" height="3202" as="geometry"/></mxCell>
