        <mxCell id="backLST" value="&lt;b&gt;SmallTalkService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontColor=#1B2A4A;dashed=0;" vertex="1" parent="1"><mxGeometry x="985" y="230" width="150" height="3202" as="geometry"/></mxCell>
