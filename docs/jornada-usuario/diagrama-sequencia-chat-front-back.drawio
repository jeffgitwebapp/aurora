        <mxCell id="backLGA" value="&lt;b&gt;GroundedAnswerService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontColor=#1B2A4A;dashed=0;" vertex="1" parent="1"><mxGeometry x="1910" y="230" width="150" height="3202" as="geometry"/></mxCell>
        <mxCell id="backLAG" value="&lt;b&gt;AnswerGuardrailService&lt;/b&gt;&lt;br&gt;guardrail de saída" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontColor=#1B2A4A;dashed=0;" vertex="1" parent="1"><mxGeometry x="2095" y="230" width="150" height="3202" as="geometry"/></mxCell>
        <mxCell id="backLDS" value="&lt;b&gt;DisclosureService&lt;/b&gt;&lt;br&gt;relato pessoal (U-14)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontColor=#1B2A4A;dashed=0;" vertex="1" parent="1"><mxGeometry x="2280" y="230" width="150" height="3202" as="geometry"/></mxCell>
        <mxCell id="backLDT" value="&lt;b&gt;DecisionTraceService&lt;/b&gt;&lt;br&gt;só metadados" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#F0F0F0;strokeColor=#999999;fontSize=11;fontColor=#1B2A4A;dashed=0;" vertex="1" parent="1"><mxGeometry x="2465" y="230" width="150" height="3202" as="geometry"/></mxCell>
        <mxCell id="backc21" value="&lt;b&gt;Entrada.&lt;/b&gt; O router recebe a mensagem, valida o corpo e chama o handler, que executa as etapas sempre na mesma ordem. Qualquer etapa pode encerrar o fluxo com a resposta final. Mensagem vazia é recusada com 422." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="386" width="440" height="72" as="geometry"/></mxCell>
        <mxCell id="backc23" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="400" as="sourcePoint"/><mxPoint x="2685" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc28" value="&lt;b&gt;[message.strip() vazio]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="82" y="502" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="backc31" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="backc33" value="&lt;b&gt;Triagem de risco (sempre primeiro, sem LLM).&lt;/b&gt; Procura por padrões sinais de ideação suicida, agressão em curso, ameaça de morte ou arma. Na dúvida, prefere o falso positivo. Com sinal (acute) ou dúvida (indeterminate), o fluxo para sem texto de resposta e o front abre a tela de risco." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="614" width="440" height="86" as="geometry"/></mxCell>
        <mxCell id="backc35" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="628" as="sourcePoint"/><mxPoint x="2685" y="628" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc40" value="&lt;b&gt;[triage.status ≠ NO_ACUTE_SIGNAL (acute | indeterminate)]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="82" y="728" width="715" height="20" as="geometry"/></mxCell>
        <mxCell id="backc43" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="726" width="785" height="114" as="geometry"/></mxCell>
        <mxCell id="backc45" value="&lt;b&gt;Limite de escopo.&lt;/b&gt; Pedidos de diagnóstico, prescrição ou parecer jurídico sobre o caso individual recebem um texto fixo explicando o limite, e o fluxo para." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="854" width="440" height="58" as="geometry"/></mxCell>
        <mxCell id="backc47" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="868" as="sourcePoint"/><mxPoint x="2685" y="868" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc50" value="&lt;b&gt;[guardrail.decision = OUT_OF_SCOPE]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="82" y="916" width="900" height="20" as="geometry"/></mxCell>
        <mxCell id="backc53" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="914" width="970" height="114" as="geometry"/></mxCell>
        <mxCell id="backc55" value="&lt;b&gt;Conversa social.&lt;/b&gt; Se a mensagem é só uma saudação, um agradecimento ou uma despedida, responde com texto fixo, sem consultar a base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="1042" width="440" height="58" as="geometry"/></mxCell>
        <mxCell id="backc57" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="1056" as="sourcePoint"/><mxPoint x="2685" y="1056" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc60" value="&lt;b&gt;[small_talk ≠ None (mensagem é só saudação, agradecimento ou despedida)]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="82" y="1104" width="1085" height="20" as="geometry"/></mxCell>
        <mxCell id="backc63" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1102" width="1155" height="114" as="geometry"/></mxCell>
        <mxCell id="backc65" value="&lt;b&gt;Oferta de conteúdo.&lt;/b&gt; Quando a mensagem pede, convida a usuária para o guia de segurança (opcional). O fluxo para aqui." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="1230" width="440" height="44" as="geometry"/></mxCell>
        <mxCell id="backc67" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="1244" as="sourcePoint"/><mxPoint x="2685" y="1244" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc70" value="&lt;b&gt;[offer ≠ None]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="82" y="1292" width="1270" height="20" as="geometry"/></mxCell>
        <mxCell id="backc73" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1290" width="1340" height="100" as="geometry"/></mxCell>
        <mxCell id="backc75" value="&lt;b&gt;Recuperação (RAG).&lt;/b&gt; O BM25 ranqueia os trechos da base curada vigente pelas palavras da mensagem, sem LLM. Os 30 melhores viram candidatos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="1404" width="440" height="58" as="geometry"/></mxCell>
        <mxCell id="backc77" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="1418" as="sourcePoint"/><mxPoint x="2685" y="1418" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc82" value="&lt;b&gt;Seleção agêntica (opcional).&lt;/b&gt; O LLM escolhe os trechos que respondem ou pede uma nova busca com termos técnicos (até 2 vezes), para cobrir a distância entre a fala do dia a dia e o texto da lei. O trace guarda só contagens e ids." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="1500" width="440" height="72" as="geometry"/></mxCell>
        <mxCell id="backc84" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="1514" as="sourcePoint"/><mxPoint x="2685" y="1514" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc85" value="&lt;b&gt;[seletor agêntico (AURORA_AGENTIC_SEARCH=true)]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="1377" y="1502" width="1270" height="20" as="geometry"/></mxCell>
        <mxCell id="backc86" value="&lt;b&gt;[até decidir; no máximo 2 buscas extras]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="1386" y="1536" width="512" height="20" as="geometry"/></mxCell>
        <mxCell id="backc91" value="&lt;b&gt;[search_query nova e can_search]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="1395" y="1718" width="309" height="20" as="geometry"/></mxCell>
        <mxCell id="backc94" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1333" y="1716" width="379" height="80" as="geometry"/></mxCell>
        <mxCell id="backc95" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1324" y="1534" width="582" height="282" as="geometry"/></mxCell>
        <mxCell id="backc97" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=6 4;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1315" y="1878" as="sourcePoint"/><mxPoint x="2655" y="1878" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc98" value="&lt;b&gt;[seletor simples (padrão)]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="1323" y="1880" width="1324" height="20" as="geometry"/></mxCell>
        <mxCell id="backc100" value="&lt;b&gt;Seleção simples (padrão).&lt;/b&gt; O LLM recebe os candidatos e devolve só os ids dos trechos que ajudam a responder. Ele não responde à usuária nem decide risco ou escopo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="1906" width="440" height="58" as="geometry"/></mxCell>
        <mxCell id="backc102" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="1920" as="sourcePoint"/><mxPoint x="2685" y="1920" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc107" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1315" y="1500" width="1340" height="546" as="geometry"/></mxCell>
        <mxCell id="backc110" value="&lt;b&gt;Resultado da busca.&lt;/b&gt; Só valem ids que estavam entre os candidatos: o LLM não cria fonte. Os escolhidos (até 5) viram trechos com a referência da fonte. Sem trecho escolhido = sem fonte, e o LLM de redação não é chamado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="2102" width="440" height="72" as="geometry"/></mxCell>
        <mxCell id="backc112" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="2116" as="sourcePoint"/><mxPoint x="2685" y="2116" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc116" value="&lt;b&gt;[knowledge.status = NO_SOURCE]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="82" y="2200" width="2565" height="20" as="geometry"/></mxCell>
        <mxCell id="backc118" value="&lt;b&gt;Sem fonte: não inventar.&lt;/b&gt; Se a mensagem é um relato pessoal de violência, responde com acolhimento e indica os canais da tela. Caso contrário, diz que não encontrou fonte confiável." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="2232" width="440" height="58" as="geometry"/></mxCell>
        <mxCell id="backc120" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="2246" as="sourcePoint"/><mxPoint x="2685" y="2246" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc125" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=6 4;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="2384" as="sourcePoint"/><mxPoint x="2655" y="2384" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc126" value="&lt;b&gt;[knowledge.status = FOUND]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="28" y="2386" width="2619" height="20" as="geometry"/></mxCell>
        <mxCell id="backc128" value="&lt;b&gt;Redação ancorada.&lt;/b&gt; O LLM recebe só os trechos escolhidos e a mensagem, e devolve segmentos curtos, cada um com os ids das fontes que o sustentam." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="2412" width="440" height="58" as="geometry"/></mxCell>
        <mxCell id="backc130" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="2426" as="sourcePoint"/><mxPoint x="2685" y="2426" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc136" value="&lt;b&gt;Falha fechada.&lt;/b&gt; Se o LLM não responde, nada é exibido à usuária e o router devolve 503." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="2552" width="440" height="44" as="geometry"/></mxCell>
        <mxCell id="backc138" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="2566" as="sourcePoint"/><mxPoint x="2685" y="2566" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc139" value="&lt;b&gt;[LanguageModelUnavailableError]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="1941" y="2554" width="697" height="20" as="geometry"/></mxCell>
        <mxCell id="backc142" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=6 4;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1879" y="2650" as="sourcePoint"/><mxPoint x="2646" y="2650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc143" value="&lt;b&gt;[LLM respondeu]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="1887" y="2652" width="751" height="20" as="geometry"/></mxCell>
        <mxCell id="backc148" value="&lt;b&gt;Guardrail de saída (sem LLM).&lt;/b&gt; Regras determinísticas reprovam a resposta inteira se faltar citação, se citar fonte desconhecida ou se houver diagnóstico, prescrição, decisão pela usuária, parecer individual, contato ou link não autorizado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="2748" width="440" height="72" as="geometry"/></mxCell>
        <mxCell id="backc150" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="2762" as="sourcePoint"/><mxPoint x="2685" y="2762" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc155" value="&lt;b&gt;[not check.passed]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="1950" y="2890" width="679" height="20" as="geometry"/></mxCell>
        <mxCell id="backc158" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=6 4;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1888" y="2986" as="sourcePoint"/><mxPoint x="2637" y="2986" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc159" value="&lt;b&gt;[aprovada]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="1896" y="2988" width="733" height="20" as="geometry"/></mxCell>
        <mxCell id="backc161" value="&lt;b&gt;Resposta aprovada.&lt;/b&gt; Os ids viram marcadores [n] na ordem das fontes e a resposta segue com a lista de fontes. O trace registra só metadados (modelo, tokens, ids), nunca a mensagem nem a resposta. Reprovada, vira 503 como na falha do LLM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="3014" width="440" height="72" as="geometry"/></mxCell>
        <mxCell id="backc163" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="3028" as="sourcePoint"/><mxPoint x="2685" y="3028" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc168" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1888" y="2888" width="749" height="280" as="geometry"/></mxCell>
        <mxCell id="backc169" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1879" y="2552" width="767" height="636" as="geometry"/></mxCell>
        <mxCell id="backc170" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="2198" width="2635" height="1010" as="geometry"/></mxCell>
        <mxCell id="backc172" value="&lt;b&gt;Indisponibilidade.&lt;/b&gt; Erro em escopo, busca ou redação vira 503 com mensagem genérica; o front mostra o alerta com &quot;Tentar novamente&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#5B8FB9;fontSize=11;fontColor=#1B2A4A;align=left;verticalAlign=top;spacingLeft=40;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2685" y="3222" width="440" height="58" as="geometry"/></mxCell>
        <mxCell id="backc174" value="" style="html=1;edgeStyle=none;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#5B8FB9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2625" y="3236" as="sourcePoint"/><mxPoint x="2685" y="3236" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="backc175" value="&lt;b&gt;[GuardrailUnavailableError | KnowledgeUnavailableError | ChatResponseUnavailableError]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="82" y="3224" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="backc178" value="break" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=22;fillColor=none;swimlaneFillColor=none;strokeColor=#5B8FB9;fontStyle=1;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="3222" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="backc1" value="&lt;b&gt;Aurora — Diagrama de sequência do chat: Backend (motor llm)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=22;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="2555" height="40" as="geometry"/></mxCell>
        <mxCell id="backc2" value="Feature send_message: triagem → limite de escopo → small talk → oferta → RAG (BM25 + seleção pelo LLM) → resposta ancorada → guardrail de saída" style="text;html=1;align=center;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="2555" height="24" as="geometry"/></mxCell>
        <mxCell id="backc3" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="200" height="18" as="geometry"/></mxCell>
        <mxCell id="backc4" value="" style="rounded=0;html=1;fillColor=#C8DFF0;strokeColor=#5B8FB9;" vertex="1" parent="1"><mxGeometry x="60" y="132" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="backc5" value="HTTP / contrato" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="88" y="130" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="backc6" value="" style="rounded=0;html=1;fillColor=#DAE8FC;strokeColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="290" y="132" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="backc7" value="Orquestração (handler)" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="318" y="130" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="backc8" value="" style="rounded=0;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="520" y="132" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="backc9" value="Regra determinística (sem LLM)" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="548" y="130" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="backc10" value="" style="rounded=0;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="750" y="132" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="backc11" value="RAG / redação" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="778" y="130" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="backc12" value="" style="rounded=0;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="60" y="158" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="backc13" value="Provedor de LLM (externo)" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="88" y="156" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="backc14" value="" style="rounded=0;html=1;fillColor=#F0F0F0;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="290" y="158" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="backc15" value="Observabilidade" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="318" y="156" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="backc16" value="" style="rounded=0;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="520" y="158" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="backc17" value="Frontend" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=11;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="548" y="156" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="backc18" value="&lt;b&gt;Composição na subida (main.py → engine.build_conversation_engine):&lt;/b&gt; AURORA_CHAT_ENGINE=llm cria KnowledgeBaseRepository.from_file() (knowledge_base.json),&lt;br&gt;KnowledgeBaseService com LanguageModelChunkSelector (ou LanguageModelAgenticChunkSelector se AURORA_AGENTIC_SEARCH=true) e GroundedAnswerService + AnswerGuardrailService.&lt;br&gt;AURORA_LLM_PROVIDER escolhe Gemini ou Claude. Triagem, escopo, small talk e oferta são determinísticos em todos os motores. O motor fixtures (mock) não aparece aqui." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="245" y="316" width="1260" height="56" as="geometry"/></mxCell>
        <mxCell id="backc19" value="&lt;b&gt;O que acontece neste ponto&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B2A4A;strokeColor=#1B2A4A;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2685" y="230" width="440" height="56" as="geometry"/></mxCell>
        <mxCell id="backc20" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1B2A4A;strokeColor=#1B2A4A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2693" y="394" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="backc22" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1B2A4A;strokeColor=#1B2A4A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-30" y="388" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="backc24" value="POST /api/chat/messages&lt;br&gt;{ message }" style="html=1;edgeStyle=none;verticalAlign=bottom;fontSize=11;fontColor=#1B2A4A;labelBackgroundColor=#FFFFFF;whiteSpace=nowrap;endArrow=block;endFill=1;strokeColor=#1B2A4A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="414" as="sourcePoint"/><mxPoint x="320" y="414" as="targetPoint"/></mxGeometry></mxCell>
