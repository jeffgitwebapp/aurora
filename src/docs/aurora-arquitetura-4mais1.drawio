        <mxCell id="p2c3f" value="&lt;b&gt;RegraHierarquiaJuridica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ ordenar(servicos): List&lt;br&gt;público formal &amp;gt; especializado &amp;gt; OSC &amp;gt; voluntário&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8EDD5;strokeColor=#5B9E72;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="p2c3">
          <mxGeometry x="180" y="165" width="330" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p2c3g" value="&lt;b&gt;PoliticaGuardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;+ validar(resposta): Veredito&lt;br&gt;bloqueia diagnóstico, parecer jurídico e decisão pela usuária&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6A040;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="p2c3">
          <mxGeometry x="560" y="165" width="330" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p2c3h" value="&lt;b&gt;«port» PortaLLM / PortaBaseVetorial / PortaCatalogo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;interfaces de saída definidas pelo domínio&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;dashed=1;" vertex="1" parent="p2c3">
          <mxGeometry x="940" y="165" width="400" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="p2c4" value="infrastructure  —  Adaptadores (implementam as portas)" style="swimlane;startSize=32;html=1;fillColor=#FAFAFA;strokeColor=#9673A6;fontSize=14;fontStyle=1;fontColor=#1B2A4A;" vertex="1" parent="1">
          <mxGeometry x="100" y="800" width="1450" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p2c4a" value="&lt;b&gt;LLMAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;implements PortaLLM&lt;br&gt;streaming SSE&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="p2c4">
          <mxGeometry x="40" y="45" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2c4b" value="&lt;b&gt;VectorStoreRepository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;implements PortaBaseVetorial&lt;br&gt;índice HNSW + alias swap&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="p2c4">
          <mxGeometry x="320" y="45" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2c4c" value="&lt;b&gt;CatalogoRepository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;implements PortaCatalogo&lt;br&gt;PostgreSQL versionado&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="p2c4">
          <mxGeometry x="600" y="45" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2c4d" value="&lt;b&gt;CacheAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Redis — respostas frequentes&lt;br&gt;invalidação por versão&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="p2c4">
          <mxGeometry x="880" y="45" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2c4e" value="&lt;b&gt;TelemetriaAnonimaAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;métricas agregadas&lt;br&gt;« nunca registra o relato »&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="p2c4">
          <mxGeometry x="1160" y="45" width="250" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="p2d1" value="depende de" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="p2c1" target="p2c2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2d2" value="depende de" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="p2c2" target="p2c3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2d3" value="&amp;lt;&amp;lt;realize&amp;gt;&amp;gt;  (inversão de dependência)" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="p2c4" target="p2c3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p2n1" value="&lt;b&gt;Princípio arquitetural:&lt;/b&gt; as setas de dependência apontam sempre &lt;b&gt;para dentro&lt;/b&gt;, em direção ao domínio. A infraestrutura implementa portas definidas pelo domínio (RNF05 — trocar o provedor de LLM não altera o núcleo). Nenhuma classe de domínio possui atributo de identificação pessoal (RNF01)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#AAAAAA;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="990" width="1450" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

