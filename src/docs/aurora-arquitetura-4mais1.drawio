        <mxCell id="p3m1" value="1. enviarRelato(texto)   « HTTPS / TLS 1.3, sem PII »" style="endArrow=block;html=1;verticalAlign=bottom;strokeColor=#1B2A4A;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="185" as="sourcePoint"/><mxPoint x="320" y="185" as="targetPoint"/></mxGeometry></mxCell>
