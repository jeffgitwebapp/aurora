        </mxCell>

        <mxCell id="p5llm" value="&lt;b&gt;«node» (externo)&lt;/b&gt;&lt;br&gt;Provedor de LLM&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Amazon Bedrock ou API equivalente&lt;br&gt;acesso por adaptador isolado (RNF05)&lt;br&gt;degradação graciosa se indisponível (RNF02)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1500" y="430" width="130" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="p5c1" value="HTTPS / TLS 1.3" style="endArrow=block;html=1;strokeColor=#1B2A4A;fontSize=11;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" source="p5n1" target="p5n3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5c2" value="HTTPS / SSE" style="endArrow=block;html=1;strokeColor=#1B2A4A;fontSize=11;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" source="p5n1" target="p5n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5c4" value="HTTPS + MFA" style="endArrow=block;html=1;strokeColor=#AAAAAA;fontSize=11;" edge="1" source="p5n2" target="p5pipe" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5c5" value="HTTPS (streaming)" style="endArrow=block;html=1;strokeColor=#9673A6;strokeWidth=2;fontSize=11;dashed=1;" edge="1" source="p5az2a" target="p5llm" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p5leg" value="&lt;b&gt;Decisões de implantação&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Multi-AZ, não multi-região&lt;/b&gt; — atende RNF02 (99,5%) dentro da restrição orçamentária R1.&lt;br&gt;• &lt;b&gt;Região sa-east-1&lt;/b&gt; — dados sensíveis mantidos em território nacional (RNF06 / LGPD).&lt;br&gt;• &lt;b&gt;Fargate em vez de EC2&lt;/b&gt; — elimina gestão de servidores; equipe acadêmica de tempo parcial (R3).&lt;br&gt;• &lt;b&gt;Sugestão de emergência sem LLM&lt;/b&gt; — conteúdo embarcado no service worker; permanece legível com a nuvem indisponível, desde que a usuária já tenha acessado antes (RNF02/RNF07).&lt;br&gt;• &lt;b&gt;Logs sem relato&lt;/b&gt; — CloudWatch recebe apenas métricas agregadas e não identificáveis (RNF01)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#AAAAAA;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="1000" width="1050" height="140" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="5b - Implantação MVP" id="p6">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p6t1" value="&lt;b&gt;Projeto Aurora — Visão 5b: Implantação MVP (mínimo utilizável)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=22;fontColor=#1B2A4A;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p6t2" value="Topologia mínima para validação com usuárias reais (M3/M4). Relaxa deliberadamente RNF02, RNF05 e parte de RNF07 — preserva integralmente RNF01, RNF03, RNF04 e RNF06." style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="230" y="58" width="1200" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="p6dev" value="&lt;b&gt;«device»&lt;/b&gt;&lt;br&gt;Dispositivo da Usuária&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;navegador móvel / anônimo&lt;br&gt;PWA + service worker&lt;br&gt;« inalterado em relação à v1 »&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#1B2A4A;strokeColor=#1B2A4A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="250" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="p6adm" value="&lt;b&gt;«device»&lt;/b&gt;&lt;br&gt;Estação do Administrador&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;acesso ao /admin com MFA&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#F0F0F0;strokeColor=#AAAAAA;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="250" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="p6ing" value="&lt;b&gt;«artifact»&lt;/b&gt; Pipeline de ingestão manual&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;script CLI executado pelo administrador:&lt;br&gt;chunking → embedding → carga no pgvector.&lt;br&gt;Curadoria humana mantida (RNF04).&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#AAAAAA;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="250" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="p6cloud" value="Provedor de nuvem — região sa-east-1  ·  ZONA DE DISPONIBILIDADE ÚNICA" style="swimlane;startSize=34;html=1;fillColor=#FAFAFA;strokeColor=#D6A040;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#5E3D00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="900" height="630" as="geometry"/>
        </mxCell>

        <mxCell id="p6cdn" value="&lt;b&gt;«node»&lt;/b&gt; Object Storage + CDN&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PWA estática · TLS 1.3&lt;br&gt;camada gratuita suficiente para o MVP&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8DFF0;strokeColor=#5B8FB9;fontSize=12;" vertex="1" parent="p6cloud">
          <mxGeometry x="40" y="55" width="390" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p6log" value="&lt;b&gt;«node»&lt;/b&gt; Logs gerenciados (nível básico)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sem conteúdo de relato e sem PII (RNF01 preservado)&lt;br&gt;sem tracing distribuído nem alertas automáticos&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#AAAAAA;fontSize=12;" vertex="1" parent="p6cloud">
          <mxGeometry x="470" y="55" width="390" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="p6app" value="&lt;b&gt;«node»&lt;/b&gt;  Container único — 1 instância (App Runner / ECS Fargate 1 task)" style="swimlane;startSize=32;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#1B2A4A;" vertex="1" parent="p6cloud">
          <mxGeometry x="40" y="175" width="820" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p6app1" value="&lt;b&gt;«artifact»&lt;/b&gt; aurora-mvp:{versão} — monólito modular&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Orquestrador de Conversa · Serviço de Triagem · Motor RAG&lt;br&gt;Serviço de Encaminhamento · Serviço de Catálogo · Painel /admin&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="p6app">
          <mxGeometry x="20" y="45" width="390" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p6app2" value="&lt;b&gt;«component»&lt;/b&gt; Classificador Determinístico + Guardrails&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;regras em processo, sem LLM · fail-closed&lt;br&gt;&lt;b&gt;RNF03 e RNF06 mantidos integralmente&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFD7D7;strokeColor=#CC0000;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="p6app">
          <mxGeometry x="430" y="45" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p6app3" value="&lt;b&gt;Cache em memória do processo&lt;/b&gt; (substitui o Redis) — perdido a cada reinício.  ·  &lt;b&gt;Sem load balancer, sem réplica, sem auto scaling.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6A040;fontSize=11;" vertex="1" parent="p6app">
          <mxGeometry x="20" y="140" width="780" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="p6db" value="&lt;b&gt;«node»&lt;/b&gt;  PostgreSQL gerenciado — instância única (db.t4g.micro), &lt;u&gt;sem Multi-AZ&lt;/u&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Catálogo de Serviços (versionado)  +  Base vetorial via extensão &lt;b&gt;pgvector&lt;/b&gt;  +  Documentos-fonte&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;um único banco substitui RDS Multi-AZ + OpenSearch + S3 · backup diário automático · criptografia em repouso&lt;/font&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#C8EDD5;strokeColor=#5B9E72;fontSize=12;" vertex="1" parent="p6cloud">
          <mxGeometry x="40" y="410" width="820" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="p6llm" value="&lt;b&gt;«node» (externo)&lt;/b&gt;&lt;br&gt;Provedor de LLM&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;API pay-per-use&lt;br&gt;acesso via adaptador isolado&lt;br&gt;(mesma porta da v1 — RNF05 estrutural preservado)&lt;br&gt;&lt;br&gt;&lt;b&gt;Ponto único de falha do caminho de conteúdo&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1380" y="330" width="220" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="p6c1" value="HTTPS / TLS 1.3" style="endArrow=block;html=1;strokeColor=#1B2A4A;fontSize=11;" edge="1" source="p6dev" target="p6cdn" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6c2" value="HTTPS / SSE" style="endArrow=block;html=1;strokeColor=#1B2A4A;fontSize=11;" edge="1" source="p6dev" target="p6app" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6c4" value="HTTPS + MFA  →  /admin" style="endArrow=block;html=1;strokeColor=#AAAAAA;fontSize=11;" edge="1" source="p6adm" target="p6app" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6c5" value="carga direta" style="endArrow=block;html=1;strokeColor=#AAAAAA;dashed=1;fontSize=11;" edge="1" source="p6ing" target="p6db" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6c6" value="HTTPS (streaming)" style="endArrow=block;html=1;strokeColor=#9673A6;strokeWidth=2;dashed=1;fontSize=11;" edge="1" source="p6app" target="p6llm" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p6box1" value="&lt;b&gt;INEGOCIÁVEIS — mantidos integralmente no MVP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;RNF01 Anonimato&lt;/b&gt; — zero PII. Não há banco de usuárias; logs sem relato. Custo zero de implementação: é ausência de funcionalidade.&lt;br&gt;&lt;b&gt;RNF03 Confiabilidade da triagem&lt;/b&gt; — classificador determinístico e exibição da sugestão de emergência em 100% dos casos. Roda em processo, não exige infraestrutura.&lt;br&gt;&lt;b&gt;RNF04 Rastreabilidade (RAG)&lt;/b&gt; — citação obrigatória mantida. Base menor em volume, mesma exigência de fonte.&lt;br&gt;&lt;b&gt;RNF06 Conformidade legal e ética&lt;/b&gt; — guardrails fail-closed. Sem eles não há permissão ética para colocar o sistema diante de uma usuária real." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#EAF7EF;strokeColor=#5B9E72;strokeWidth=2;fontSize=12;fontColor=#1B2A4A;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="760" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="p6box2" value="&lt;b&gt;RELAXADOS NO MVP — dívida arquitetural assumida&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;RNF02 Disponibilidade&lt;/b&gt; — de 99,5% multi-AZ para ~99% best-effort em AZ única. Deploy causa indisponibilidade de 1–2 min. &lt;i&gt;Mitigação parcial: sugestão de emergência e conteúdo essencial ficam offline no service worker — apenas para quem já acessou antes.&lt;/i&gt;&lt;br&gt;&lt;b&gt;RNF05 Atualização sem downtime&lt;/b&gt; — publicação do catálogo exige reinício do container. &lt;i&gt;Mitigação: janela combinada de madrugada; sem auto scaling — carga limitada por convite.&lt;/i&gt;&lt;br&gt;&lt;b&gt;RNF07 Desempenho (parcial)&lt;/b&gt; — resposta RAG completa sobe de ≤3 s para ≤5 s (pgvector sem reranker, cache volátil). &lt;i&gt;Exibição da sugestão de emergência e Saída Rápida permanecem ≤500 ms e ≤200 ms: rodam no cliente.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFF4E6;strokeColor=#D6A040;strokeWidth=2;fontSize=12;fontColor=#5E3D00;" vertex="1" parent="1">
          <mxGeometry x="840" y="830" width="760" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="p6crit" value="&lt;b&gt;Critério de saída do MVP → arquitetura alvo (aba 5):&lt;/b&gt; uso concorrente sustentado acima de 50 sessões, ou primeira parceria institucional formalizada, ou incidente de indisponibilidade em horário noturno." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#1B2A4A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="790" width="1200" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
