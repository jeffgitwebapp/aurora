        <mxCell id="p3f1l" value="par  [triagem concorrente]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8DFF0;strokeColor=#5B8FB9;fontSize=11;fontStyle=1" vertex="1" parent="1">
