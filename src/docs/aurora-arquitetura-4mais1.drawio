        <mxCell id="p3m4" value="4. classificarSemantico(texto) → necessidade, localização" style="endArrow=block;html=1;verticalAlign=bottom;strokeColor=#6C8EBF;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="355" as="sourcePoint"/><mxPoint x="920" y="355" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3m5" value="5. nivelUrgencia   « precedência sobre o classificador semântico »" style="endArrow=open;dashed=1;html=1;verticalAlign=bottom;strokeColor=#CC0000;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="405" as="sourcePoint"/><mxPoint x="520" y="405" as="targetPoint"/></mxGeometry></mxCell>

