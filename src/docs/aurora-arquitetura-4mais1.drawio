          <mxGeometry x="80" y="646" width="160" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="p3m9" value="9. recuperarFontes(consulta, top-k)   « índice HNSW, limiar de similaridade »" style="endArrow=block;html=1;verticalAlign=bottom;strokeColor=#6C8EBF;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="695" as="sourcePoint"/><mxPoint x="920" y="695" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3m10" value="10. gerarResposta(prompt + trechos recuperados)" style="endArrow=block;html=1;verticalAlign=bottom;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="735" as="sourcePoint"/><mxPoint x="1520" y="735" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3m11" value="11. stream de tokens (SSE)   « RNF07: 1º token ≤ 1,5 s »" style="endArrow=open;dashed=1;html=1;verticalAlign=bottom;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="777" as="sourcePoint"/><mxPoint x="920" y="777" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="p3m12" value="12. validarEscopo(resposta)   « fail-closed: bloqueia diagnóstico e parecer jurídico »" style="endArrow=block;html=1;verticalAlign=bottom;strokeColor=#D6A040;fontSize=11;fontStyle=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="840" as="sourcePoint"/><mxPoint x="1120" y="840" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3m13" value="13. resposta aprovada + fontes citadas   « RNF04: ≥90% com fonte rastreável »" style="endArrow=open;dashed=1;html=1;verticalAlign=bottom;strokeColor=#D6A040;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="882" as="sourcePoint"/><mxPoint x="520" y="882" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3m14" value="14. buscarServicos(uf, municipio, necessidade)" style="endArrow=block;html=1;verticalAlign=bottom;strokeColor=#5B9E72;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="924" as="sourcePoint"/><mxPoint x="1320" y="924" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3m15" value="15. serviços ordenados pela hierarquia jurídica (cache Redis)" style="endArrow=open;dashed=1;html=1;verticalAlign=bottom;strokeColor=#5B9E72;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="966" as="sourcePoint"/><mxPoint x="520" y="966" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p3m16" value="16. resposta psicoeducativa com citações + até 3 opções de encaminhamento   « RNF07: completa ≤ 3 s »" style="endArrow=open;dashed=1;html=1;verticalAlign=bottom;strokeColor=#1B2A4A;strokeWidth=2;fontSize=11;fontStyle=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1010" as="sourcePoint"/><mxPoint x="120" y="1010" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="p3n1" value="&lt;b&gt;Concorrência:&lt;/b&gt; o classificador determinístico (regras) e o classificador semântico executam em paralelo. O resultado determinístico tem &lt;b&gt;precedência absoluta&lt;/b&gt; — prefere-se falso positivo a falso negativo em emergência (RNF03). &lt;b&gt;Assincronia:&lt;/b&gt; a resposta do LLM é entregue por streaming; a telemetria anônima é publicada em fila, fora do caminho crítico. &lt;b&gt;Falha do provedor de LLM:&lt;/b&gt; o fluxo degrada para conteúdo pré-renderizado e catálogo estático (RNF02)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#AAAAAA;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="1070" width="1490" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

