        <mxCell id="p3m8" value="8. exibe a sugestão prioritária de emergência   « RNF03: 100% dos casos · RNF07: p95 ≤ 500 ms »" style="endArrow=open;dashed=1;html=1;verticalAlign=bottom;strokeColor=#CC0000;strokeWidth=2;fontSize=11;fontStyle=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="606" as="sourcePoint"/><mxPoint x="120" y="606" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="p3sep" style="endArrow=none;dashed=1;html=1;strokeColor=#1B2A4A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="640" as="sourcePoint"/><mxPoint x="1560" y="640" as="targetPoint"/></mxGeometry></mxCell>
