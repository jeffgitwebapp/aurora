        <mxCell id="leg3" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#083F75&quot;&gt;■&lt;/font&gt; Pessoa   &lt;font color=&quot;#23A2D9&quot;&gt;■&lt;/font&gt; Container   &lt;font color=&quot;#63BEF2&quot;&gt;■&lt;/font&gt; Componente&lt;br&gt;&lt;font color=&quot;#CC0000&quot;&gt;■&lt;/font&gt; Caminho determinístico de segurança   &lt;font color=&quot;#D6A040&quot;&gt;■&lt;/font&gt; Guardrail&lt;br&gt;&lt;font color=&quot;#5B9E72&quot;&gt;■&lt;/font&gt; Serviço de domínio   &lt;font color=&quot;#9673A6&quot;&gt;■&lt;/font&gt; Adaptador (porta)   &lt;font color=&quot;#8C8496&quot;&gt;■&lt;/font&gt; Externo&lt;br&gt;- - - Fronteira do container" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFFFFF;strokeColor=#AAAAAA;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="1400" width="1180" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="nt3" value="&lt;b&gt;Duas separações carregam requisito&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Classificador Determinístico isolado&lt;/b&gt; — não compartilha dependência com o pipeline de IA. Torna o CA-02 mensurável de forma determinística (RNF03).&lt;br&gt;&lt;b&gt;2. Guardrails entre o LLM e a saída&lt;/b&gt; — nenhuma resposta gerada alcança a usuária sem passar por ele, em &lt;i&gt;fail-closed&lt;/i&gt; (RNF06 / CA-03).&lt;br&gt;&lt;br&gt;Os &lt;b&gt;adaptadores&lt;/b&gt; são os únicos componentes que mudam na migração MVP → arquitetura alvo." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFF4E6;strokeColor=#D6A040;fontSize=12;fontColor=#5E3D00;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1400" width="1180" height="190" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="C4-4 Implantação (MVP)" id="c4p3">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3t1" value="&lt;b&gt;Projeto Aurora — C4 Implantação: topologia MVP&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=22;fontColor=#0D5091;" vertex="1" parent="1">
          <mxGeometry x="427" y="18" width="800" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c3t2" value="Mínimo utilizável para validação com usuárias reais (M3–M4). Relaxa RNF02, RNF05 e a latência RAG · Preserva integralmente RNF01, RNF03, RNF04 e RNF06." style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="277" y="54" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c3n1" value="&lt;b&gt;Dispositivo da Usuária&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Deployment Node: smartphone Android ou iOS]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Potencialmente monitorado pelo agressor.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="105" width="360" height="410" as="geometry" />
        </mxCell>
        <mxCell id="c3n1a" value="&lt;b&gt;Navegador em aba anônima&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Deployment Node]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;" vertex="1" parent="c3n1">
          <mxGeometry x="20" y="80" width="320" height="310" as="geometry" />
        </mxCell>
        <mxCell id="c3c1" value="&lt;b&gt;PWA Aurora&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: HTML, JS, Service Worker]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Interface camuflada, sem rastro de instalação. Saída Rápida em menos de 200 ms.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="c3n1a">
          <mxGeometry x="15" y="55" width="290" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c3c2" value="&lt;b&gt;Cache Offline&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Cache API]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sugestão de emergência e conteúdo essencial, legíveis sem rede.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#23A2D9;strokeColor=#D6A040;strokeWidth=3;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;spacingTop=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="c3n1a">
          <mxGeometry x="15" y="185" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c3n2" value="&lt;b&gt;Estação do Administrador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Deployment Node: desktop com MFA]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="555" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c3c3" value="&lt;b&gt;CLI de Ingestão&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: script Python]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Chunking, embedding e carga da base citável após curadoria humana.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="c3n2">
          <mxGeometry x="20" y="55" width="320" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c3out" value="&lt;b&gt;Por que não há nó de emergência&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Os serviços de emergência (190, 180, 188, 192) e a rede de proteção (DEAM, CREAS, CRAS, Defensoria) &lt;b&gt;não aparecem em nenhum diagrama&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Não são infraestrutura, não recebem chamadas e não hospedam containers. São &lt;b&gt;registros do Banco Aurora&lt;/b&gt; — dados que o sistema exibe.&lt;br&gt;&lt;br&gt;Ligar para o serviço é &lt;b&gt;ação da própria usuária&lt;/b&gt;, fora do modelo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="795" width="360" height="235" as="geometry" />
        </mxCell>
        <mxCell id="c3n4" value="&lt;b&gt;Provedor de nuvem — região sa-east-1&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Deployment Node: ZONA DE DISPONIBILIDADE ÚNICA]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sem multi-AZ e sem multi-região. Dados em território nacional (LGPD).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6A040;strokeWidth=2;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#5E3D00;" vertex="1" parent="1">
          <mxGeometry x="490" y="105" width="800" height="920" as="geometry" />
        </mxCell>
        <mxCell id="c3n4a" value="&lt;b&gt;Object Storage + CDN&lt;/b&gt;  &lt;i&gt;[Deployment Node: camada gratuita]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;" vertex="1" parent="c3n4">
          <mxGeometry x="30" y="80" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c3c5" value="&lt;b&gt;Artefatos estáticos da PWA&lt;/b&gt;  &lt;i&gt;[Container: bundle JS/CSS/HTML]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Servidos pela borda com TLS 1.3. Carga alvo de 2 s em rede 3G.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="c3n4a">
          <mxGeometry x="20" y="45" width="700" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c3n4b" value="&lt;b&gt;Instância de container única&lt;/b&gt;  &lt;i&gt;[Deployment Node: App Runner ou 1 task Fargate · 0.5 vCPU · 1 GB]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;" vertex="1" parent="c3n4">
          <mxGeometry x="30" y="245" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c3c6" value="&lt;b&gt;Aplicação Aurora&lt;/b&gt;  &lt;i&gt;[Container: monólito modular]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Orquestrador · Triagem · &lt;b&gt;Classificador Determinístico de Emergência&lt;/b&gt; · Motor RAG · &lt;b&gt;Guardrails fail-closed&lt;/b&gt; · Encaminhamento · Catálogo · Painel /admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="c3n4b">
          <mxGeometry x="20" y="45" width="700" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c3n4c" value="&lt;b&gt;PostgreSQL gerenciado&lt;/b&gt;  &lt;i&gt;[Deployment Node: db.t4g.micro · instância única, sem Multi-AZ]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;" vertex="1" parent="c3n4">
          <mxGeometry x="30" y="450" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c3c7" value="&lt;b&gt;Banco Aurora&lt;/b&gt;  &lt;i&gt;[Container: PostgreSQL 16 + pgvector]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Catálogo versionado, base vetorial e documentos-fonte em um único banco.&lt;br&gt;Backup diário automático e criptografia em repouso.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="c3n4c">
          <mxGeometry x="20" y="45" width="700" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c3n4d" value="&lt;b&gt;Serviço de logs gerenciado&lt;/b&gt;  &lt;i&gt;[Deployment Node: nível básico, sem tracing e sem alertas]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;" vertex="1" parent="c3n4">
          <mxGeometry x="30" y="655" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c3c8" value="&lt;b&gt;Logs da aplicação&lt;/b&gt;  &lt;i&gt;[Container: log estruturado]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Métricas agregadas. &lt;b&gt;Nunca registra o conteúdo do relato nem qualquer PII&lt;/b&gt; (RNF01).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="c3n4d">
          <mxGeometry x="20" y="45" width="700" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c3warn" value="&lt;b&gt;SEM&lt;/b&gt; load balancer  ·  &lt;b&gt;SEM&lt;/b&gt; réplica  ·  &lt;b&gt;SEM&lt;/b&gt; auto scaling  ·  cada deploy causa 1–2 min de indisponibilidade  ·  dimensionado para até ~50 sessões concorrentes" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF4E6;strokeColor=#D6A040;fontSize=11;fontColor=#5E3D00;" vertex="1" parent="c3n4">
          <mxGeometry x="30" y="825" width="740" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c3n5" value="&lt;b&gt;Infraestrutura de terceiros&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Deployment Node: fora da fronteira de responsabilidade]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#736782;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1350" y="270" width="260" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c3c9" value="&lt;b&gt;API do Provedor de LLM&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: serviço pay-per-use]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Única integração externa do sistema.&lt;/b&gt;&lt;br&gt;Ponto único de falha do caminho de conteúdo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;" vertex="1" parent="c3n5">
          <mxGeometry x="20" y="70" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c3r1" value="Carrega o bundle&lt;br&gt;&lt;i&gt;[HTTPS/TLS 1.3]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" source="c3c1" target="c3c5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3r2" value="Envia o relato e recebe a resposta&lt;br&gt;&lt;i&gt;[JSON/HTTPS, SSE]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" source="c3c1" target="c3c6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3r3" value="Lê a sugestão de emergência&lt;br&gt;quando está sem rede&lt;br&gt;&lt;i&gt;[Cache API]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D6A040;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" source="c3c1" target="c3c2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3r5" value="Consulta o catálogo e recupera trechos&lt;br&gt;&lt;i&gt;[SQL, pgvector]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" source="c3c6" target="c3c7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3r6" value="Solicita geração ancorada nas fontes&lt;br&gt;&lt;i&gt;[JSON/HTTPS]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" source="c3c6" target="c3c9" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3r7" value="Publica métricas agregadas sem PII&lt;br&gt;&lt;i&gt;[stdout]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" source="c3c6" target="c3c8" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3r8" value="Carrega chunks e embeddings&lt;br&gt;&lt;i&gt;[SQL]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" source="c3c3" target="c3c7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3fail" value="&lt;b&gt;Comportamento sob falha&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;LLM indisponível&lt;/b&gt; → sem chat; permanecem triagem determinística, sugestão de emergência e catálogo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Aplicação fora do ar&lt;/b&gt; → permanece o que estiver &lt;b&gt;já em cache&lt;/b&gt; no dispositivo.&lt;br&gt;&lt;br&gt;&lt;b&gt;AZ inteira fora do ar&lt;/b&gt; → idem.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dispositivo sem rede&lt;/b&gt; → idem.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B0000&quot;&gt;&lt;b&gt;RESSALVA:&lt;/b&gt; o cache só existe após o primeiro carregamento bem-sucedido. Numa &lt;b&gt;primeira visita&lt;/b&gt; com o sistema indisponível, a usuária não recebe nada — nem a sugestão de emergência.&lt;br&gt;&lt;br&gt;A afirmação da v1 de que &quot;em nenhum cenário o caminho de risco de vida é perdido&quot; &lt;b&gt;não se sustenta&lt;/b&gt; com a interpretação correta. Isso &lt;b&gt;eleva&lt;/b&gt; o peso do RNF02.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF4E6;strokeColor=#CC0000;strokeWidth=2;fontSize=11;fontColor=#5E3D00;" vertex="1" parent="1">
          <mxGeometry x="1350" y="560" width="260" height="470" as="geometry" />
        </mxCell>
        <mxCell id="c3leg" value="&lt;b&gt;Legenda&lt;/b&gt;   &lt;font color=&quot;#23A2D9&quot;&gt;■&lt;/font&gt; Container   &lt;font color=&quot;#8C8496&quot;&gt;■&lt;/font&gt; Externo   ▭ Nó de implantação   ⬭ Armazenamento   &lt;font color=&quot;#D6A040&quot;&gt;━&lt;/font&gt; Conteúdo de sugestão de emergência" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#AAAAAA;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="1050" width="800" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
