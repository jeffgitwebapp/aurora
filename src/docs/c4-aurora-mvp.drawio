<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.17 Chrome/128.0.6613.36 Electron/32.0.1 Safari/537.36" version="24.7.17" pages="3">
  <diagram name="C4-1 Contexto" id="c4p1">
    <mxGraphModel dx="2911" dy="749" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1t1" value="&lt;b&gt;Projeto Aurora — C4 Nível 1: Contexto do Sistema&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=22;fontColor=#0D5091;" parent="1" vertex="1">
          <mxGeometry x="427" y="26" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1t2" value="Público: patrocinador, coordenação acadêmica e parceiros institucionais  ·  Sem tecnologias, por definição do nível  ·  v3.0 — serviços da rede de proteção são dados do catálogo, não elementos de arquitetura" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="327" y="66" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c1p1" value="&lt;b&gt;Usuária&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Mulher em situação de violência psicológica. Acessa de forma anônima, sem cadastro e sem se identificar.&lt;/font&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="240" y="140" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c1p2" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Mantém o catálogo de serviços da rede de proteção e a base de conhecimento citável.&lt;/font&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="1050" y="140" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c1s1" value="&lt;b&gt;Aurora&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Software System]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Plataforma de psicoeducação e informação. Ajuda a reconhecer padrões de violência, informa direitos e &lt;b&gt;sugere qual entidade procurar&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Não aciona órgãos, não diagnostica, não faz terapia e não presta aconselhamento jurídico individualizado.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
          <mxGeometry x="580" y="430" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c1e1" value="&lt;b&gt;Provedor de LLM&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Software System · externo]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Geração de linguagem natural a partir do contexto recuperado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Única integração real do Aurora.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
          <mxGeometry x="1210" y="460" width="290" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c1r1" value="Relata a situação e consulta&lt;br&gt;conteúdo psicoeducativo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.65;exitY=1;entryX=0.35;entryY=0;" parent="1" source="c1p1" target="c1s1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1r5" value="&lt;b&gt;Sugere qual entidade procurar&lt;/b&gt;,&lt;br&gt;com dados de contato e hierarquia jurídica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.1;exitY=0;entryX=0.9;entryY=1;" parent="1" source="c1s1" target="c1p1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1r2" value="Atualiza o catálogo de serviços&lt;br&gt;e a base de conhecimento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" parent="1" source="c1p2" target="c1s1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1r3" value="Solicita geração de respostas&lt;br&gt;ancoradas em fontes recuperadas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" parent="1" source="c1s1" target="c1e1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1note" value="&lt;b&gt;Leitura arquitetural&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quatro caixas. O Aurora tem &lt;b&gt;um único sistema externo&lt;/b&gt;: o Provedor de LLM.&lt;br&gt;&lt;br&gt;DEAM, CREAS, CRAS, Defensoria, 190, 180, 188 e 192 &lt;b&gt;não aparecem&lt;/b&gt; porque não são elementos de arquitetura — são &lt;b&gt;linhas do Catálogo de Serviços&lt;/b&gt;, dentro do próprio sistema. Procurar o serviço é ação da própria usuária, fora do modelo.&lt;br&gt;&lt;br&gt;Isso elimina quase todo risco de integração, mas &lt;b&gt;transfere para a usuária o último passo do fluxo&lt;/b&gt;. O risco migra de &lt;i&gt;integração&lt;/i&gt; para &lt;i&gt;qualidade de dado&lt;/i&gt; — o que eleva a criticidade do RNF03 e da atualização do catálogo (RNF05)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF4E6;strokeColor=#D6A040;fontSize=12;fontColor=#5E3D00;" parent="1" vertex="1">
          <mxGeometry x="420" y="740" width="740" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c1corr" value="&lt;b&gt;Correção de requisito&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;v1&lt;/b&gt; modelava discagem direta (&lt;i&gt;tel:&lt;/i&gt;) — incorreto.&lt;br&gt;&lt;b&gt;v2&lt;/b&gt; manteve os órgãos como sistemas externos — ainda incorreto.&lt;br&gt;&lt;b&gt;v3&lt;/b&gt; removeu-os do modelo: são &lt;b&gt;dados do catálogo&lt;/b&gt;, não arquitetura." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFE6E6;strokeColor=#CC0000;strokeWidth=2;fontSize=11;fontColor=#6B0000;" parent="1" vertex="1">
          <mxGeometry x="60" y="380" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c1leg" value="&lt;b&gt;Legenda C4&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#083F75&quot;&gt;■&lt;/font&gt; Pessoa (ator)&lt;br&gt;&lt;font color=&quot;#1061B0&quot;&gt;■&lt;/font&gt; Sistema em foco&lt;br&gt;&lt;font color=&quot;#8C8496&quot;&gt;■&lt;/font&gt; Sistema externo&lt;br&gt;━ Comunicação do sistema" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#AAAAAA;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="600" width="300" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="C4-2 Containers (MVP)" id="c4p2">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;Projeto Aurora — C4 Nível 2: Containers (topologia MVP)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;fontColor=#0D5091;" vertex="1" parent="1">
          <mxGeometry x="500" y="30" width="1300" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&quot;Container&quot; no C4 = unidade executável com processo ou armazenamento próprio — não é Docker. Infraestrutura aparece só na aba de Implantação." style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=14;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="400" y="82" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="b" value="Aurora — MVP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0D5091;strokeWidth=2;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=16;fontStyle=1;fontColor=#0D5091;" vertex="1" parent="1">
          <mxGeometry x="430" y="170" width="1420" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Usuária&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Acesso anônimo, sem cadastro.&lt;/font&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="240" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Curadoria do catálogo e da base citável.&lt;/font&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="240" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;PWA Aurora&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: HTML, JS, Service Worker]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Interface camuflada. Saída Rápida em menos de 200 ms, sem rede.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="210" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Cache Offline&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Cache API]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sugestão de emergência e conteúdo essencial, legíveis sem rede.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#23A2D9;strokeColor=#D6A040;fontColor=#FFFFFF;fontSize=13;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="500" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;CLI de Ingestão&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: script Python]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Chunking, embedding e carga após curadoria humana.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="820" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Aplicação Aurora&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: monólito modular]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Orquestrador · Triagem · &lt;b&gt;Classificador Determinístico&lt;/b&gt; · Motor RAG · &lt;b&gt;Guardrails fail-closed&lt;/b&gt; · Encaminhamento · Catálogo · /admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="320" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Banco Aurora&lt;/b&gt;&lt;br&gt;&lt;i&gt;[PostgreSQL 16 + pgvector]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Catálogo de Serviços versionado, base vetorial e documentos-fonte.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;fontSize=13;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1480" y="640" width="320" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;Provedor de LLM&lt;/b&gt;&lt;br&gt;&lt;i&gt;[externo]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;API pay-per-use.&lt;br&gt;&lt;b&gt;Único sistema externo.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1900" y="250" width="260" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="Acessa e relata&lt;br&gt;[HTTPS/TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.41;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="p1" target="c1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" value="Lê cache offline&lt;br&gt;[Cache API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D6A040;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="c1" target="c2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" value="Envia relato&lt;br&gt;[JSON/HTTPS, SSE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.79;exitDx=0;exitDy=0;entryX=0;entryY=0.09;entryDx=0;entryDy=0;" edge="1" source="c1" target="c3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r5" value="Solicita geração&lt;br&gt;[JSON/HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.47;entryDx=0;entryDy=0;" edge="1" source="c3" target="e1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r7" value="Executa carga" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.41;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="p2" target="c5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.73;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="c3" target="c4" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="460"/><mxPoint x="1390" y="640"/></Array></mxGeometry></mxCell>
        <mxCell id="r4-lbl" value="Consulta e recupera&lt;br&gt;[SQL, pgvector]" style="text;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1321" y="556" width="137" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="r6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;" edge="1" source="p2" target="c3" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="480"/><mxPoint x="980" y="480"/></Array></mxGeometry></mxCell>
        <mxCell id="r6-lbl" value="Cadastra serviços&lt;br&gt;[HTTPS + MFA]" style="text;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="327" y="456" width="125" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="r8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="c5" target="c4" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="890"/><mxPoint x="1150" y="720"/></Array></mxGeometry></mxCell>
        <mxCell id="r8-lbl" value="Grava chunks e embeddings&lt;br&gt;[SQL]" style="text;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="887" y="866" width="175" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="leg" value="&lt;b&gt;Legenda C4&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#083F75&quot;&gt;■&lt;/font&gt; Pessoa (ator)&lt;br&gt;&lt;font color=&quot;#23A2D9&quot;&gt;■&lt;/font&gt; Container do Aurora&lt;br&gt;&lt;font color=&quot;#8C8496&quot;&gt;■&lt;/font&gt; Sistema externo&lt;br&gt;⬭ Cilindro = armazenamento&lt;br&gt;&lt;font color=&quot;#D6A040&quot;&gt;━&lt;/font&gt; Conteúdo de sugestão de emergência&lt;br&gt;- - - Fronteira do sistema" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFFFFF;strokeColor=#AAAAAA;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1060" width="700" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="nt" value="&lt;b&gt;Reduções em relação à arquitetura alvo&lt;/b&gt;&lt;br&gt;&lt;br&gt;• API Gateway + BFF + serviços separados → &lt;b&gt;um monólito modular&lt;/b&gt; (restrição R3)&lt;br&gt;• RDS + OpenSearch + S3 → &lt;b&gt;um PostgreSQL com pgvector&lt;/b&gt; (ADR-10)&lt;br&gt;• ElastiCache Redis → cache em memória do processo, volátil&lt;br&gt;• AWS Batch / Lambda → &lt;b&gt;CLI de ingestão manual&lt;/b&gt; (dívida D5)&lt;br&gt;&lt;br&gt;&lt;b&gt;Fronteira:&lt;/b&gt; DEAM, CREAS, CRAS, Defensoria, 190, 180, 188 e 192 são &lt;b&gt;registros do Banco Aurora&lt;/b&gt; — não são containers, atores nem sistemas externos." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFF4E6;strokeColor=#D6A040;fontSize=12;fontColor=#5E3D00;" vertex="1" parent="1">
          <mxGeometry x="820" y="1060" width="1340" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="C4-3 Componentes (Aplicação Aurora)" id="c4p4">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;Projeto Aurora — C4 Nível 3: Componentes da Aplicação Aurora&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;fontColor=#0D5091;" vertex="1" parent="1">
